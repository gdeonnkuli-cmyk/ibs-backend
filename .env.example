PORT=3000

# Obligatoire : l'API refuse de démarrer sans. Générer avec `openssl rand -hex 32`.
JWT_SECRET=

DATABASE_URL=postgresql://user:password@host:5432/dbname

ADMIN_PHONE=+243800000000
ADMIN_PASSWORD=admin123

# Passerelle SMS Africa's Talking. Sans AT_API_KEY/AT_USERNAME, les SMS sont
# seulement journalisés (mode simulé).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false

# "true" active la route de test /api/auth/dev/last-otp et l'affichage des OTP
# dans les logs. Toute autre valeur (ou variable absente) les désactive.
# NE JAMAIS mettre "true" en production.
DEV_MODE=false

# Stockage des pièces justificatives (CNI, titres, photos). Sans ces variables,
# le stockage est inactif : /api/uploads/signature rend 503 et les URLs de
# documents sont acceptées telles quelles (développement uniquement).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# "false" coupe les rappels automatiques (fin de bail, loyers en retard).
# Ils sont également désactivés quand DEV_MODE=true.
RAPPELS_AUTO=true
