PORT=3000

# Obligatoire : l'API refuse de démarrer sans. Générer avec `openssl rand -hex 32`.
JWT_SECRET=

DATABASE_URL=postgresql://user:password@host:5432/dbname

ADMIN_PHONE=+243800000000
ADMIN_PASSWORD=admin123

# Passerelle SMS Africa's Talking. Sans AT_API_KEY/AT_USERNAME, les SMS sont
# seulement journalisés (mode simulé).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false

# "true" active la route de test /api/auth/dev/last-otp et l'affichage des OTP
# dans les logs. Toute autre valeur (ou variable absente) les désactive.
# NE JAMAIS mettre "true" en production.
DEV_MODE=false

# Stockage des pièces justificatives (CNI, titres, photos). Sans ces variables,
# le stockage est inactif : /api/uploads/signature rend 503 et les URLs de
# documents sont acceptées telles quelles (développement uniquement).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Uniquement pour les tests, contre un service de téléversement factice.
# En production, laisser vide : la valeur par défaut est l'API Cloudinary.
CLOUDINARY_UPLOAD_URL=

# "false" coupe les rappels automatiques (fin de bail, loyers en retard).
# Ils sont également désactivés quand DEV_MODE=true.
RAPPELS_AUTO=true

# ── Passerelle de paiement ──────────────────────────────────────────────
# Prestataire utilisé pour l'encaissement. Voir passerelles/README.md pour en
# ajouter un. Une valeur inconnue empêche le serveur de démarrer, plutôt que
# de laisser croire que l'encaissement fonctionne.
#
# ATTENTION : Flutterwave ne couvre pas la RDC. Pour Kinshasa, utiliser flexpay
# ou maxicash — dont les correspondances de champs restent à confronter à la
# documentation des prestataires, voir l'en-tête de chaque adaptateur.
# Valeurs : flutterwave | flexpay | maxicash | factice (tests uniquement).
PASSERELLE_PAIEMENT=flutterwave

# FlexPay et MaxiCash encaissent sur le compte marchand d'IBS, qui reverse
# ensuite au bailleur. Ce mode fait transiter par la plateforme l'argent
# d'autrui, ce qui relève en RDC du statut d'établissement de paiement. Il ne
# s'active donc pas tout seul : sans "oui" ici, l'encaissement reste fermé.
ENCAISSEMENT_TRANSIT_ASSUME=

# ── FlexPay (RDC) ───────────────────────────────────────────────────────
FLEXPAY_TOKEN=
FLEXPAY_MERCHANT=
FLEXPAY_API_URL=
FLEXPAY_SIGNATURE_HEADER=

# ── MaxiCash (RDC) ──────────────────────────────────────────────────────
# Rappel : MaxiCash exprime les montants en centimes.
MAXICASH_MERCHANT_ID=
MAXICASH_MERCHANT_PASSWORD=
MAXICASH_API_URL=
MAXICASH_NOTIFY_URL=
MAXICASH_SIGNATURE_HEADER=

# ── Flutterwave ─────────────────────────────────────────────────────────

# Sert aux abonnements Premium et au paiement du loyer par Mobile Money.
# Sans FLUTTERWAVE_SECRET_KEY et FLUTTERWAVE_REDIRECT_URL, ces deux
# fonctionnalités rendent 503 et l'application n'en propose aucune.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# URL de retour après paiement : doit pointer vers l'application hébergée.
FLUTTERWAVE_REDIRECT_URL=
# Uniquement pour les tests, contre une passerelle factice locale.
# En production, laisser vide : la valeur par défaut est l'API réelle.
FLUTTERWAVE_API_URL=

# Part prélevée par IBS sur chaque loyer encaissé, en pourcentage (0 à 50).
# À vide ou absente : 0, le bailleur reçoit l'intégralité du loyer.
IBS_COMMISSION_LOYER_PCT=
